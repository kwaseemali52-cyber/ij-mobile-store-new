.product-image {
  width: 100%;
  height: 220px;
  object-fit: contain;
  border-radius: 12px;
}

.price-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.old-price {
  color: #888;
  text-decoration: line-through;
  font-size: 14px;
}

.price {
  color: #e53935;
  font-size: 22px;
  font-weight: bold;
}

.tag {
  background: #e53935;
  color: white;
  padding: 6px 10px;
  border-radius: 6px;
}
